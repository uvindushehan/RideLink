        {
          "name": "Create Ride",
          "item": [
            {
              "name": "POST /api/rides",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{jwtToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"passengerId\": \"PASSENGER-001\",\n  \"pickupLocation\": {\n    \"latitude\": 6.9271,\n    \"longitude\": 79.8612,\n    \"placeName\": \"Colombo\"\n  },\n  \"destinationLocation\": {\n    \"latitude\": 6.9147,\n    \"longitude\": 79.9729,\n    \"placeName\": \"Battaramulla\"\n  }\n}"
                },
                "url": {
                  "raw": "{{rideServiceBaseUrl}}/api/rides",
                  "host": [
                    "{{rideServiceBaseUrl}}"
                  ],
                  "path": [
                    "api",
                    "rides"
                  ]
                }
              }
            }
          ]
        },

        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refundAmount\": 500.00\n}"
        },
        "url": {
          "raw": "http://localhost:8084/api/payments/PAYMENT-ID-HERE/refund",
          "protocol": "http",
